# =============================================================================
# CREA Pro-Link | Modelo de variaveis de ambiente
#
# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# O arquivo .env NAO deve ser versionado nem entregue com credenciais reais
# (item 8.3.1.k do Termo de Referencia).
# =============================================================================

# --- Ambiente -----------------------------------------------------------------
# desenvolvimento | homologacao | producao
APP_AMBIENTE=desenvolvimento
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_NOME="CREA Pro-Link"
APP_CHAVE=

# --- Banco de dados (MariaDB 10.11+) -----------------------------------------
DB_HOST=mariadb
DB_PORTA=3306
DB_NOME=crea_prolink
DB_USUARIO=prolink
DB_SENHA=
DB_CHARSET=utf8mb4

# --- API oficial do desafio CREA-AM -------------------------------------------
# Token individual obtido em https://desafio-prolink.crea-am.org.br
# A URL base e o formato dos endpoints constam da documentacao entregue
# as equipes habilitadas; ajuste conforme ela.
CREA_API_URL=https://desafio-prolink.crea-am.org.br/api/v1
CREA_API_TOKEN=
CREA_API_TIMEOUT=15
# http = consome a API oficial (unico valor valido para avaliacao)
# offline = nao consulta a API; a aplicacao informa a indisponibilidade ao
#           usuario sem inventar dados. Use apenas para desenvolvimento local
#           de telas que nao dependem da integracao.
CREA_API_DRIVER=http

# Caminhos dos recursos, conforme a documentacao v1 da API oficial.
# A API usa querystring (?p=<recurso>); o marcador entre chaves e
# substituido pelo parametro da consulta.
CREA_API_ROTA_PROFISSIONAL=?p=profissionais
CREA_API_ROTA_EMPRESA=?p=empresas
CREA_API_ROTA_ART=?p=profissionais/{rnp}/arts
CREA_API_ROTA_ART_NUMERO=?p=arts
CREA_API_ROTA_CAT=?p=profissionais/{rnp}/cats
CREA_API_ROTA_CAT_NUMERO=?p=cats

# --- Envio de e-mail (SMTP) ---------------------------------------------------
# Estes valores sao o padrao inicial; o administrador pode sobrescreve-los
# pelo painel administrativo (RF07).
MAIL_ATIVO=false
MAIL_HOST=
MAIL_PORTA=587
MAIL_SEGURANCA=tls
MAIL_USUARIO=
MAIL_SENHA=
MAIL_REMETENTE_EMAIL=nao-responda@prolink.local
MAIL_REMETENTE_NOME="CREA Pro-Link"

# --- Sessao e seguranca -------------------------------------------------------
SESSAO_NOME=prolink_sessao
SESSAO_TEMPO_MINUTOS=120
SESSAO_COOKIE_SEGURO=false
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
