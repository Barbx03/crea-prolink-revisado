{# =============================================================================
   Template único das notificações por e-mail (RF07).

   HTML com estilo em linha, que é o que os clientes de e-mail interpretam de
   forma confiável. Recebe: titulo, mensagem, detalhes (mapa), link,
   acao_texto.
   ============================================================================ #}
<div style="margin:0;padding:24px 0;background-color:#f6f8fa;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:#21272e;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
        <tr>
            <td align="center">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600"
                       style="max-width:600px;width:100%;background:#ffffff;border:1px solid #dee3e9;border-radius:10px;overflow:hidden;">

                    <tr>
                        <td style="background:#0b3d6b;padding:18px 24px;color:#ffffff;">
                            <span style="font-size:18px;font-weight:700;letter-spacing:-0.01em;">CREA Pro-Link</span>
                            <span style="display:block;font-size:12px;opacity:0.85;margin-top:2px;">
                                Conselho Regional de Engenharia e Agronomia do Amazonas
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:24px;">
                            <h1 style="margin:0 0 12px;font-size:19px;line-height:1.35;color:#0b3d6b;">
                                {{ titulo }}
                            </h1>

                            {% if mensagem is defined and mensagem %}
                                <p style="margin:0 0 16px;font-size:15px;line-height:1.6;">{{ mensagem }}</p>
                            {% endif %}

                            {% if detalhes is defined and detalhes is not empty %}
                                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
                                       style="margin:0 0 20px;font-size:14px;border-collapse:collapse;">
                                    {% for rotulo, valor in detalhes %}
                                        {% if valor %}
                                            <tr>
                                                <td style="padding:7px 0;border-bottom:1px solid #eef1f4;color:#5b6875;width:42%;">
                                                    {{ rotulo }}
                                                </td>
                                                <td style="padding:7px 0;border-bottom:1px solid #eef1f4;font-weight:600;">
                                                    {{ valor }}
                                                </td>
                                            </tr>
                                        {% endif %}
                                    {% endfor %}
                                </table>
                            {% endif %}

                            {% if link %}
                                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td style="background:#0b3d6b;border-radius:6px;">
                                            <a href="{{ app.url }}/{{ link|trim('/') }}"
                                               style="display:inline-block;padding:11px 22px;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;">
                                                {{ acao_texto|default('Acessar a plataforma') }}
                                            </a>
                                        </td>
                                    </tr>
                                </table>

                                <p style="margin:16px 0 0;font-size:12px;color:#5b6875;line-height:1.5;">
                                    Se o botão não funcionar, copie e cole este endereço no navegador:<br>
                                    <span style="word-break:break-all;">{{ app.url }}/{{ link|trim('/') }}</span>
                                </p>
                            {% endif %}
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:16px 24px;background:#f6f8fa;border-top:1px solid #dee3e9;font-size:12px;color:#5b6875;line-height:1.6;">
                            <p style="margin:0 0 6px;">
                                Esta é uma mensagem automática do CREA Pro-Link. Não responda a este e-mail.
                            </p>
                            <p style="margin:0;">
                                Você pode gerenciar quais comunicações recebe no
                                <a href="{{ app.url }}/privacidade" style="color:#0b3d6b;">painel de privacidade</a>
                                da plataforma.
                            </p>
                        </td>
                    </tr>
                </table>

                <p style="margin:14px 0 0;font-size:11px;color:#8d99a6;">
                    Protótipo do Desafio CREA Pro-Link · {{ app.ano }}
                </p>
            </td>
        </tr>
    </table>
</div>
