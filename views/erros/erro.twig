{% extends 'layout/base.twig' %}

{% block titulo %}Erro {{ codigo }} | {{ app.nome }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block conteudo %}
    <div class="row justify-content-center py-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body text-center p-4 p-md-5">
                    <p class="display-4 text-muted mb-2" aria-hidden="true">
                        <i class="bi bi-{{ codigo == 404 ? 'compass' : (codigo == 403 ? 'shield-lock' : 'exclamation-triangle') }}"></i>
                    </p>

                    <h1 class="h3">
                        {% if codigo == 404 %}Página não encontrada
                        {% elseif codigo == 403 %}Acesso não autorizado
                        {% elseif codigo == 419 %}A página expirou
                        {% elseif codigo == 405 %}Método não permitido
                        {% else %}Não foi possível concluir a operação
                        {% endif %}
                    </h1>

                    <p class="text-muted">{{ mensagem }}</p>

                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
                        <a class="btn btn-primary" href="{{ url('/') }}">Ir para a página inicial</a>
                        {% if autenticado() %}
                            <a class="btn btn-outline-primary" href="{{ url('/painel') }}">Meu painel</a>
                        {% else %}
                            <a class="btn btn-outline-primary" href="{{ url('/entrar') }}">Entrar</a>
                        {% endif %}
                    </div>

                    <p class="small text-muted mt-4 mb-0">Código do erro: {{ codigo }}</p>

                    {% if detalhe %}
                        <div class="alert alert-secondary text-start mt-4 small">
                            <p class="fw-semibold mb-1">Detalhe técnico (apenas em modo de depuração)</p>
                            <p class="mb-2 font-monospace">{{ detalhe }}</p>
                            {% if rastro %}
                                <pre class="mb-0" style="max-height: 260px; overflow: auto; font-size: 0.75rem;">{{ rastro }}</pre>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
