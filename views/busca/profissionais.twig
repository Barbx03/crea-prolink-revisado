{% extends 'layout/base.twig' %}

{% block menu_ativo %}profissionais{% endblock %}
{% block titulo %}Buscar profissionais | {{ app.nome }}{% endblock %}

{% block conteudo %}
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1">Buscar profissionais e empresas</h1>
            <p class="text-muted small mb-0">
                {{ paginacao.total|numero }} perfil(is) encontrado(s).
                Perfis com registro validado no CREA-AM aparecem identificados.
            </p>
        </div>
    </div>

    <div class="row g-4">
        {# --- Filtros ---------------------------------------------------- #}
        <div class="col-lg-3">
            <form method="get" action="{{ url('/profissionais') }}" class="card">
                <div class="card-body">
                    <h2 class="h6 mb-3">Filtros</h2>

                    <div class="mb-3">
                        <label class="form-label" for="termo">Nome, título ou resumo</label>
                        <input type="search" class="form-control form-control-sm" id="termo" name="termo"
                               value="{{ filtros.termo }}">
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="area_id">Área de atuação</label>
                        <select class="form-select form-select-sm" id="area_id" name="area_id">
                            <option value="">Todas as áreas</option>
                            {% for area in areas %}
                                <option value="{{ area.are_id }}" {{ filtros.area_id == area.are_id ? 'selected' : '' }}>
                                    {{ area.are_nome }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label" for="uf">UF</label>
                            <select class="form-select form-select-sm" id="uf" name="uf" data-uf-origem>
                                <option value="">Todas</option>
                                {% for uf in ufs %}
                                    <option value="{{ uf }}" {{ filtros.uf == uf ? 'selected' : '' }}>{{ uf }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-8">
                            <label class="form-label" for="cidade">Cidade</label>
                            <input type="text" class="form-control form-control-sm" id="cidade" name="cidade"
                                   value="{{ filtros.cidade }}" list="lista-municipios">
                            <datalist id="lista-municipios"></datalist>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="perfil">Tipo de perfil</label>
                        <select class="form-select form-select-sm" id="perfil" name="perfil">
                            <option value="">Profissionais e empresas</option>
                            <option value="PROFISSIONAL" {{ filtros.perfil == 'PROFISSIONAL' ? 'selected' : '' }}>
                                Somente profissionais
                            </option>
                            <option value="EMPRESA" {{ filtros.perfil == 'EMPRESA' ? 'selected' : '' }}>
                                Somente empresas
                            </option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="disponibilidade">Disponibilidade</label>
                        <select class="form-select form-select-sm" id="disponibilidade" name="disponibilidade">
                            <option value="">Qualquer</option>
                            {% for valor in ['DISPONIVEL', 'PARCIAL', 'INDISPONIVEL'] %}
                                <option value="{{ valor }}" {{ filtros.disponibilidade == valor ? 'selected' : '' }}>
                                    {{ valor|rotulo }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="experiencia_min">Experiência mínima (anos)</label>
                        <input type="number" class="form-control form-control-sm" id="experiencia_min"
                               name="experiencia_min" min="0" max="50"
                               value="{{ filtros.experiencia_min ?: '' }}">
                    </div>

                    <fieldset class="mb-3">
                        <legend class="form-label">Verificação</legend>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="somente_registrados" value="1"
                                   id="somente_registrados" {{ filtros.somente_registrados ? 'checked' : '' }}>
                            <label class="form-check-label small" for="somente_registrados">
                                Somente registrados no CREA-AM
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="com_acervo" value="1"
                                   id="com_acervo" {{ filtros.com_acervo ? 'checked' : '' }}>
                            <label class="form-check-label small" for="com_acervo">
                                Com ART ou CAT validada
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="incluir_remoto" value="1"
                                   id="incluir_remoto" {{ filtros.incluir_remoto ? 'checked' : '' }}>
                            <label class="form-check-label small" for="incluir_remoto">
                                Incluir quem atende remoto
                            </label>
                        </div>
                    </fieldset>

                    <details class="mb-3" {{ filtros.competencias is not empty ? 'open' : '' }}>
                        <summary class="form-label mb-2">Competências técnicas</summary>
                        {% include 'partials/competencias-selecao.twig' with {
                            competencias: competencias,
                            selecionadas: filtros.competencias
                        } only %}
                    </details>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Aplicar filtros</button>
                        <a class="btn btn-outline-secondary btn-sm" href="{{ url('/profissionais') }}">Limpar</a>
                    </div>
                </div>
            </form>
        </div>

        {# --- Resultados ------------------------------------------------- #}
        <div class="col-lg-9">
            <form method="get" class="d-flex justify-content-end align-items-center gap-2 mb-3">
                {% for chave, valor in filtros %}
                    {% if valor and chave != 'ordem' %}
                        {% if valor is iterable %}
                            {% for item in valor %}
                                <input type="hidden" name="{{ chave }}[]" value="{{ item }}">
                            {% endfor %}
                        {% else %}
                            <input type="hidden" name="{{ chave }}" value="{{ valor }}">
                        {% endif %}
                    {% endif %}
                {% endfor %}

                <label class="form-label mb-0 small" for="ordem">Ordenar por</label>
                <select class="form-select form-select-sm w-auto" id="ordem" name="ordem" data-submete-formulario>
                    {% set ordens = {
                        'relevancia': 'Relevância',
                        'nome': 'Nome',
                        'experiencia': 'Tempo de experiência',
                        'acervo': 'Acervo validado',
                        'recentes': 'Cadastros recentes'
                    } %}
                    {% for valor, rotulo in ordens %}
                        <option value="{{ valor }}" {{ filtros.ordem == valor ? 'selected' : '' }}>{{ rotulo }}</option>
                    {% endfor %}
                </select>
                <noscript><button type="submit" class="btn btn-sm btn-outline-primary">Ordenar</button></noscript>
            </form>

            {% if itens is empty %}
                {% include 'partials/lista-vazia.twig' with {
                    icone: 'search',
                    titulo: 'Nenhum perfil encontrado',
                    mensagem: 'Não há perfis que atendam a todos os filtros aplicados. Tente ampliar a busca, remover a exigência de acervo ou incluir quem atende remotamente.'
                } only %}
            {% else %}
                <div class="row g-3">
                    {% for perfil in itens %}
                        <div class="col-md-6">
                            {% include 'partials/cartao-perfil.twig' with { perfil: perfil } only %}
                        </div>
                    {% endfor %}
                </div>

                {% include 'partials/paginacao.twig' with { paginacao: paginacao } only %}
            {% endif %}
        </div>
    </div>
{% endblock %}
