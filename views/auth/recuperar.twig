{% extends 'layout/base.twig' %}

{% block titulo %}Recuperar acesso | {{ app.nome }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block conteudo %}
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card">
                <div class="card-body p-4">
                    <h1 class="h4 mb-1">Recuperar acesso</h1>
                    <p class="text-muted small mb-4">
                        Informe o e-mail do seu cadastro. Enviaremos um link de uso único
                        para você definir uma nova senha.
                    </p>

                    <form method="post" action="{{ url('/recuperar-acesso') }}" novalidate>
                        {{ campo_csrf() }}

                        <div class="mb-3">
                            <label class="form-label obrigatorio" for="email">E-mail cadastrado</label>
                            <input type="email" class="form-control {{ erros.email is defined ? 'is-invalid' : '' }}"
                                   id="email" name="email" value="{{ formulario.email|default('') }}"
                                   autocomplete="username" required autofocus>
                            {% include 'partials/campo-erro.twig' with { campo: 'email', erros: erros } only %}
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Enviar instruções</button>
                    </form>

                    <p class="small text-muted mt-3 mb-0">
                        Por segurança, a mensagem de confirmação é a mesma exista ou não cadastro
                        para o endereço informado.
                    </p>

                    <hr class="my-4">
                    <a class="small" href="{{ url('/entrar') }}">Voltar para o acesso</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
