{% extends 'layout/base.twig' %}

{% block titulo %}Definir nova senha | {{ app.nome }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block conteudo %}
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card">
                <div class="card-body p-4">
                    <h1 class="h4 mb-1">Definir nova senha</h1>
                    <p class="text-muted small mb-4">
                        Este link é de uso único. Após a redefinição, todos os outros links
                        pendentes desta conta deixam de valer.
                    </p>

                    <form method="post" action="{{ url('/redefinir-senha') }}" novalidate>
                        {{ campo_csrf() }}
                        <input type="hidden" name="token" value="{{ token }}">

                        <div class="mb-3">
                            <label class="form-label obrigatorio" for="senha">Nova senha</label>
                            <input type="password" class="form-control {{ erros.senha is defined ? 'is-invalid' : '' }}"
                                   id="senha" name="senha" autocomplete="new-password" required autofocus>
                            <div class="form-text">
                                Ao menos 8 caracteres, combinando três entre: minúscula, maiúscula,
                                número e símbolo.
                            </div>
                            {% include 'partials/campo-erro.twig' with { campo: 'senha', erros: erros } only %}
                        </div>

                        <div class="mb-3">
                            <label class="form-label obrigatorio" for="senha_confirmacao">Repetir a nova senha</label>
                            <input type="password" class="form-control {{ erros.senha_confirmacao is defined ? 'is-invalid' : '' }}"
                                   id="senha_confirmacao" name="senha_confirmacao" autocomplete="new-password" required>
                            {% include 'partials/campo-erro.twig' with { campo: 'senha_confirmacao', erros: erros } only %}
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Salvar nova senha</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
