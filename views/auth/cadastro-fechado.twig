{% extends 'layout/base.twig' %}

{% block titulo %}Cadastro suspenso | {{ app.nome }}{% endblock %}

{% block conteudo %}
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body text-center p-5">
                    <p class="display-5 text-muted" aria-hidden="true"><i class="bi bi-pause-circle"></i></p>
                    <h1 class="h4">Cadastro temporariamente suspenso</h1>
                    <p class="text-muted">
                        A criação de novos cadastros está desativada pela administração da
                        plataforma neste momento. Quem já tem conta continua acessando normalmente.
                    </p>
                    <a class="btn btn-primary" href="{{ url('/entrar') }}">Entrar com minha conta</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
