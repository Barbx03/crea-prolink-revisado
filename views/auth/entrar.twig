{% extends 'layout/base.twig' %}

{% block titulo %}Entrar | {{ app.nome }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block conteudo %}
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card">
                <div class="card-body p-4">
                    <h1 class="h4 mb-1">Entrar na plataforma</h1>
                    <p class="text-muted small mb-4">
                        Acesse para gerenciar seu perfil, publicar demandas e responder oportunidades.
                    </p>

                    <form method="post" action="{{ url('/entrar') }}" novalidate>
                        {{ campo_csrf() }}

                        <div class="mb-3">
                            <label class="form-label obrigatorio" for="email">E-mail</label>
                            <input type="email" class="form-control {{ erros.email is defined ? 'is-invalid' : '' }}"
                                   id="email" name="email" value="{{ formulario.email|default('') }}"
                                   autocomplete="username" required autofocus>
                            {% include 'partials/campo-erro.twig' with { campo: 'email', erros: erros } only %}
                        </div>

                        <div class="mb-3">
                            <label class="form-label obrigatorio" for="senha">Senha</label>
                            <input type="password" class="form-control {{ erros.senha is defined ? 'is-invalid' : '' }}"
                                   id="senha" name="senha" autocomplete="current-password" required>
                            {% include 'partials/campo-erro.twig' with { campo: 'senha', erros: erros } only %}
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Entrar</button>
                    </form>

                    <hr class="my-4">

                    <div class="d-flex flex-column gap-2 small">
                        <a href="{{ url('/recuperar-acesso') }}">Esqueci minha senha</a>
                        <span class="text-muted">
                            Ainda não tem cadastro?
                            <a href="{{ url('/cadastrar') }}">Criar cadastro</a>
                        </span>
                    </div>
                </div>
            </div>

            <p class="small text-muted text-center mt-3 mb-0">
                Ao entrar, você concorda com os
                <a href="{{ url('/termos-de-uso') }}">Termos de Uso</a> e a
                <a href="{{ url('/politica-de-privacidade') }}">Política de Privacidade</a>.
            </p>
        </div>
    </div>
{% endblock %}
