{% extends 'layout/base.twig' %}

{% block titulo %}Perfis | Administração | {{ app.nome }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block conteudo %}
    <h1 class="h4 mb-1">Moderação de perfis</h1>
    <p class="text-muted small mb-4">
        Perfis com moderação pendente, reprovados, ou de contas bloqueadas.
        Perfis aprovados e ativos não aparecem nesta fila.
    </p>

    <div class="row g-4">
        <div class="col-lg-3">
            {% include 'admin/_menu.twig' with { secao: '/admin/moderacao' } only %}
        </div>

        <div class="col-lg-9">
            {% if itens is empty %}
                {% include 'partials/lista-vazia.twig' with {
                    icone: 'shield-check',
                    titulo: 'Nada pendente na moderação de perfis',
                    mensagem: 'Todos os perfis ativos estão aprovados.'
                } only %}
            {% else %}
                {% for perfil in itens %}
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                                <div>
                                    <h2 class="h6 mb-1">
                                        <a href="{{ url('/profissionais/' ~ perfil.prf_id) }}">{{ perfil.usu_nome }}</a>
                                    </h2>
                                    <p class="small text-muted mb-0">
                                        {{ perfil.usu_email }} · {{ perfil.usu_perfil|rotulo }} ·
                                        {{ perfil.prf_titulo|default('sem título profissional') }}
                                    </p>
                                </div>

                                <div class="text-end">
                                    {% include 'partials/selo-registro.twig' with {
                                        registrado: perfil.usu_registrado_crea
                                    } only %}
                                    <span class="badge {{ perfil.prf_moderacao == 'APROVADO' ? 'text-bg-success' : 'text-bg-warning' }} d-block mt-1">
                                        {{ perfil.prf_moderacao|rotulo }}
                                    </span>
                                </div>
                            </div>

                            {% if perfil.prf_moderacao_motivo %}
                                <p class="small text-warning">Motivo registrado: {{ perfil.prf_moderacao_motivo }}</p>
                            {% endif %}

                            <form method="post" action="{{ url('/admin/moderacao/perfis/' ~ perfil.prf_id) }}">
                                {{ campo_csrf() }}
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label small mb-1" for="mod-{{ perfil.prf_id }}">Moderação</label>
                                        <select class="form-select form-select-sm" id="mod-{{ perfil.prf_id }}" name="moderacao">
                                            {% for valor in ['APROVADO', 'EM_ANALISE', 'REPROVADO'] %}
                                                <option value="{{ valor }}" {{ perfil.prf_moderacao == valor ? 'selected' : '' }}>
                                                    {{ valor|rotulo }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="col-md-7">
                                        <label class="form-label small mb-1" for="mot-{{ perfil.prf_id }}">
                                            Motivo (obrigatório ao reprovar)
                                        </label>
                                        <input type="text" class="form-control form-control-sm"
                                               id="mot-{{ perfil.prf_id }}" name="motivo" maxlength="255">
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-sm btn-primary w-100">Aplicar</button>
                                    </div>
                                </div>
                            </form>

                            <p class="small mt-2 mb-0">
                                <a href="{{ url('/admin/usuarios/' ~ perfil.usu_id) }}">Abrir ficha administrativa do usuário</a>
                            </p>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
{% endblock %}
