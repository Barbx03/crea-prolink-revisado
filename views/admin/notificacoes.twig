{% extends 'layout/base.twig' %}

{% block titulo %}Fila de notificações | Administração | {{ app.nome }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block conteudo %}
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
        <div>
            <h1 class="h4 mb-1">Fila de notificações</h1>
            <p class="text-muted small mb-0">
                Toda notificação é gravada antes de qualquer tentativa de envio, de modo que
                nenhum evento se perde quando o SMTP está indisponível.
            </p>
        </div>

        <form method="post" action="{{ url('/admin/notificacoes/processar') }}">
            {{ campo_csrf() }}
            <button type="submit" class="btn btn-primary btn-sm" {{ smtp_ativo ? '' : 'disabled' }}>
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                Processar pendentes
            </button>
        </form>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            {% include 'admin/_menu.twig' with { secao: '/admin/notificacoes' } only %}

            <div class="card">
                <div class="card-body">
                    <h2 class="h6">Situação da fila</h2>
                    <ul class="list-unstyled small mb-3">
                        <li class="d-flex justify-content-between border-bottom py-1">
                            <span>Total</span><strong>{{ indicadores.total|numero }}</strong>
                        </li>
                        <li class="d-flex justify-content-between border-bottom py-1">
                            <span>Enviadas</span>
                            <strong class="text-success">{{ indicadores.enviadas|numero }}</strong>
                        </li>
                        <li class="d-flex justify-content-between border-bottom py-1">
                            <span>Pendentes</span>
                            <strong class="text-warning">{{ indicadores.pendentes|numero }}</strong>
                        </li>
                        <li class="d-flex justify-content-between py-1">
                            <span>Falhas</span>
                            <strong class="text-danger">{{ indicadores.falhas|numero }}</strong>
                        </li>
                    </ul>

                    {% if not smtp_ativo %}
                        <div class="alert alert-warning small mb-0">
                            SMTP desativado: os eventos são registrados, mas nenhum e-mail sai.
                            <a class="d-block mt-1" href="{{ url('/admin/configuracoes') }}">Configurar SMTP</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <form method="get" class="card mb-3">
                <div class="card-body d-flex flex-wrap gap-2 align-items-end">
                    <div>
                        <label class="form-label small mb-1" for="situacao">Situação</label>
                        <select class="form-select form-select-sm" id="situacao" name="situacao">
                            <option value="">Todas</option>
                            <option value="A" {{ filtros.situacao == 'A' ? 'selected' : '' }}>Pendentes</option>
                            <option value="E" {{ filtros.situacao == 'E' ? 'selected' : '' }}>Enviadas</option>
                            <option value="F" {{ filtros.situacao == 'F' ? 'selected' : '' }}>Com falha</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label small mb-1" for="evento">Evento</label>
                        <select class="form-select form-select-sm" id="evento" name="evento">
                            <option value="">Todos</option>
                            {% for chave, rotulo in eventos %}
                                <option value="{{ chave }}" {{ filtros.evento == chave ? 'selected' : '' }}>
                                    {{ rotulo }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
                    <a class="btn btn-outline-secondary btn-sm" href="{{ url('/admin/notificacoes') }}">Limpar</a>
                </div>
            </form>

            {% if itens is empty %}
                {% include 'partials/lista-vazia.twig' with {
                    icone: 'envelope',
                    titulo: 'Fila vazia',
                    mensagem: 'Nenhuma notificação corresponde aos filtros aplicados.'
                } only %}
            {% else %}
                <div class="card">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <caption class="small px-3">{{ paginacao.total|numero }} notificação(ões).</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Registrada</th>
                                    <th scope="col">Evento</th>
                                    <th scope="col">Destinatário</th>
                                    <th scope="col">Assunto</th>
                                    <th scope="col">Canal</th>
                                    <th scope="col">Situação</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for notificacao in itens %}
                                    <tr>
                                        <td class="small text-nowrap">{{ notificacao.not_dt_registro|data_hora }}</td>
                                        <td class="small">
                                            {{ eventos[notificacao.not_evento]|default(notificacao.not_evento) }}
                                        </td>
                                        <td class="small">
                                            {{ notificacao.usu_nome|default('—') }}
                                            {% if notificacao.not_destinatario %}
                                                <span class="d-block text-muted">{{ notificacao.not_destinatario }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="small">{{ notificacao.not_assunto|slice(0, 60) }}</td>
                                        <td class="small">{{ notificacao.not_canal|lower }}</td>
                                        <td class="small">
                                            {% if notificacao.not_status == 'E' %}
                                                <span class="text-success">enviada</span>
                                                <span class="d-block text-muted">{{ notificacao.not_dt_envio|data_hora }}</span>
                                            {% elseif notificacao.not_status == 'F' %}
                                                <span class="text-danger">falha</span>
                                                <span class="d-block text-muted">
                                                    {{ notificacao.not_tentativas }} tentativa(s)
                                                </span>
                                                {% if notificacao.not_erro %}
                                                    <details>
                                                        <summary class="small">erro</summary>
                                                        <span class="small">{{ notificacao.not_erro|slice(0, 200) }}</span>
                                                    </details>
                                                {% endif %}
                                            {% else %}
                                                <span class="text-warning">pendente</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {% include 'partials/paginacao.twig' with { paginacao: paginacao } only %}
            {% endif %}
        </div>
    </div>
{% endblock %}
