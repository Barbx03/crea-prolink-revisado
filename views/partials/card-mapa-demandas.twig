{#
    Card com os mapas de demandas: Brasil por estado e Amazonas por município.
    Espera `mapa` (RepositorioDemanda::mapaPorUf), `mapa_am`
    (RepositorioDemanda::mapaPorMunicipio) e `administrativo`: na visão
    administrativa exibe também o total cadastrado, incluindo rascunhos e encerradas.
#}
{% macro legenda(maximo) %}
    <div class="mapa-legenda small mb-3" aria-hidden="true">
        <span>Nenhuma</span>
        {% for nivel in 0..4 %}
            <span class="mapa-legenda-cor mapa-nivel-{{ nivel }}"></span>
        {% endfor %}
        <span>{{ maximo > 0 ? maximo|numero : 'Mais' }}</span>
    </div>
{% endmacro %}

{% macro ranking(itens, maximo, titulo, administrativo, rotulo_largo = false) %}
    <h2 class="h6">{{ titulo }}</h2>
    <ol class="list-unstyled mb-0">
        {% for item in itens %}
            <li class="d-flex align-items-center gap-2 mb-1">
                <a class="mapa-ranking-uf{{ rotulo_largo ? ' mapa-ranking-largo' }}" href="{{ url(item.link) }}">{{ item.rotulo }}</a>
                <progress class="mapa-ranking-barra" max="{{ maximo }}" value="{{ item.abertas }}"
                          aria-label="{{ item.abertas }} de {{ maximo }}"></progress>
                <span class="small text-nowrap">
                    <strong>{{ item.abertas|numero }}</strong>
                    {% if administrativo %}
                        <span class="text-muted">/ {{ item.total|numero }}</span>
                    {% endif %}
                </span>
            </li>
        {% endfor %}
    </ol>
    {% if administrativo %}
        <p class="small text-muted mt-2 mb-0">Abertas / total cadastradas.</p>
    {% endif %}
{% endmacro %}

{% import _self as m %}

<div class="card mb-4">
    <div class="card-header card-cabecalho-simples d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>Demandas pelo mapa</span>
        <ul class="nav nav-pills nav-pills-mapa small" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="aba-mapa-brasil" data-bs-toggle="tab" data-bs-target="#painel-mapa-brasil"
                        type="button" role="tab" aria-controls="painel-mapa-brasil" aria-selected="true">Brasil</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="aba-mapa-amazonas" data-bs-toggle="tab" data-bs-target="#painel-mapa-amazonas"
                        type="button" role="tab" aria-controls="painel-mapa-amazonas" aria-selected="false">Amazonas por município</button>
            </li>
        </ul>
    </div>
    <div class="card-body tab-content">
        {# --- Brasil, por estado ------------------------------------------ #}
        <div class="tab-pane fade show active" id="painel-mapa-brasil" role="tabpanel" aria-labelledby="aba-mapa-brasil" tabindex="0">
            <div class="row g-4 align-items-center">
                <div class="col-md-7">
                    {% include 'partials/mapa-brasil.twig' with { estados: mapa.estados, detalhado: administrativo } only %}
                </div>
                <div class="col-md-5">
                    <p class="small text-muted">
                        A cor indica quantas demandas estão abertas em cada estado.
                        Passe o cursor sobre um estado para ver os números ou clique para listar as demandas dele.
                    </p>
                    {{ m.legenda(mapa.maximo) }}
                    {% if mapa.ranking is not empty %}
                        {% set itens = [] %}
                        {% for estado in mapa.ranking %}
                            {% set itens = itens|merge([estado|merge({ rotulo: estado.uf, link: '/demandas?uf=' ~ estado.uf })]) %}
                        {% endfor %}
                        {{ m.ranking(itens, mapa.maximo, 'Estados com mais demandas abertas', administrativo) }}
                    {% else %}
                        <p class="small mb-0">Ainda não há demandas abertas com estado informado.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        {# --- Amazonas, por município ------------------------------------- #}
        <div class="tab-pane fade" id="painel-mapa-amazonas" role="tabpanel" aria-labelledby="aba-mapa-amazonas" tabindex="0">
            <div class="row g-4 align-items-center">
                <div class="col-md-7">
                    {% include 'partials/mapa-amazonas.twig' with { municipios: mapa_am.municipios, detalhado: administrativo } only %}
                </div>
                <div class="col-md-5">
                    <p class="small text-muted">
                        Os 62 municípios do Amazonas, coloridos pela quantidade de demandas abertas.
                        Clique em um município para listar as demandas dele.
                    </p>
                    {{ m.legenda(mapa_am.maximo) }}
                    {% if mapa_am.ranking is not empty %}
                        {% set itens = [] %}
                        {% for municipio in mapa_am.ranking %}
                            {% set itens = itens|merge([municipio|merge({ rotulo: municipio.cidade, link: '/demandas?uf=AM&cidade=' ~ municipio.cidade|url_encode })]) %}
                        {% endfor %}
                        {{ m.ranking(itens, mapa_am.maximo, 'Municípios com mais demandas abertas', administrativo, true) }}
                    {% else %}
                        <p class="small mb-0">Ainda não há demandas abertas com município informado no Amazonas.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <p class="mapa-credito text-muted mt-3 mb-0">
            Contornos: svg-maps (Victor Cazanave, CC BY 4.0) e malha municipal do IBGE.
        </p>
    </div>
</div>
