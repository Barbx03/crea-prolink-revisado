{# Navegação entre páginas de uma listagem.
   Preserva os filtros da consulta atual, trocando apenas o número da página. #}
{% if paginacao.paginas > 1 %}
    <nav aria-label="Paginação dos resultados" class="mt-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <p class="mb-0 small text-muted">
                Exibindo {{ paginacao.primeiro }} a {{ paginacao.ultimo }} de {{ paginacao.total|numero }} resultado(s)
            </p>

            <ul class="pagination pagination-sm mb-0">
                <li class="page-item {{ paginacao.pagina <= 1 ? 'disabled' : '' }}">
                    <a class="page-link" href="?{{ query_pagina(paginacao.pagina - 1) }}"
                       aria-label="Página anterior" {{ paginacao.pagina <= 1 ? 'tabindex="-1" aria-disabled="true"' : '' }}>
                        Anterior
                    </a>
                </li>

                {% set inicio = max(1, paginacao.pagina - 2) %}
                {% set fim = min(paginacao.paginas, inicio + 4) %}

                {% if inicio > 1 %}
                    <li class="page-item"><a class="page-link" href="?{{ query_pagina(1) }}">1</a></li>
                    {% if inicio > 2 %}
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    {% endif %}
                {% endif %}

                {% for numero in inicio..fim %}
                    <li class="page-item {{ numero == paginacao.pagina ? 'active' : '' }}">
                        <a class="page-link" href="?{{ query_pagina(numero) }}"
                           {{ numero == paginacao.pagina ? 'aria-current="page"' : '' }}>{{ numero }}</a>
                    </li>
                {% endfor %}

                {% if fim < paginacao.paginas %}
                    {% if fim < paginacao.paginas - 1 %}
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    {% endif %}
                    <li class="page-item">
                        <a class="page-link" href="?{{ query_pagina(paginacao.paginas) }}">{{ paginacao.paginas }}</a>
                    </li>
                {% endif %}

                <li class="page-item {{ paginacao.pagina >= paginacao.paginas ? 'disabled' : '' }}">
                    <a class="page-link" href="?{{ query_pagina(paginacao.pagina + 1) }}"
                       aria-label="Próxima página"
                       {{ paginacao.pagina >= paginacao.paginas ? 'tabindex="-1" aria-disabled="true"' : '' }}>
                        Próxima
                    </a>
                </li>
            </ul>
        </div>
    </nav>
{% elseif paginacao.total > 0 %}
    <p class="mt-3 mb-0 small text-muted">{{ paginacao.total|numero }} resultado(s).</p>
{% endif %}
