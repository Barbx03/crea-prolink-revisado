{# Cartão de demanda nas listagens #}
<article class="card h-100 cartao-clicavel">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <span class="badge text-bg-light border">{{ demanda.dem_modalidade|rotulo }}</span>
            {% if demanda.dem_exige_art == 'S' %}
                <span class="badge text-bg-warning" title="Exige acervo comprovado por ART ou CAT">Exige ART/CAT</span>
            {% endif %}
        </div>

        <h3 class="h6 mb-2">
            <a href="{{ url('/demandas/' ~ demanda.dem_id) }}" class="text-decoration-none">
                {{ demanda.dem_titulo }}
            </a>
        </h3>

        <p class="small text-muted mb-2">
            {% if demanda.dem_cidade or demanda.dem_uf %}
                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                {{ demanda.dem_cidade }}{{ demanda.dem_cidade and demanda.dem_uf ? ' — ' : '' }}{{ demanda.dem_uf }}
            {% endif %}
            {% if demanda.dem_aceita_remoto == 'S' %}
                <span class="ms-2"><i class="bi bi-laptop" aria-hidden="true"></i> aceita remoto</span>
            {% endif %}
        </p>

        <p class="small mb-3">{{ demanda.dem_escopo|slice(0, 170) }}{{ demanda.dem_escopo|length > 170 ? '…' : '' }}</p>

        {% if demanda.competencias is defined and demanda.competencias is not empty %}
            <div class="mb-3">
                {% for competencia in demanda.competencias|slice(0, 4) %}
                    <span class="etiqueta-competencia {{ competencia.dmc_obrigatoria == 'S' ? 'obrigatoria' : '' }}">
                        {{ competencia.cmp_nome }}
                    </span>
                {% endfor %}
                {% if demanda.competencias|length > 4 %}
                    <span class="small text-muted">+{{ demanda.competencias|length - 4 }}</span>
                {% endif %}
            </div>
        {% endif %}

        <div class="mt-auto small text-muted border-top pt-2">
            <div class="d-flex flex-wrap gap-3">
                {% if demanda.dem_orcamento_min or demanda.dem_orcamento_max %}
                    <span>
                        <i class="bi bi-cash-coin" aria-hidden="true"></i>
                        {% if demanda.dem_orcamento_min and demanda.dem_orcamento_max %}
                            {{ demanda.dem_orcamento_min|moeda }} a {{ demanda.dem_orcamento_max|moeda }}
                        {% else %}
                            {{ (demanda.dem_orcamento_max ?: demanda.dem_orcamento_min)|moeda }}
                        {% endif %}
                    </span>
                {% endif %}
                {% if demanda.dem_dt_limite %}
                    <span><i class="bi bi-calendar-event" aria-hidden="true"></i> até {{ demanda.dem_dt_limite|data }}</span>
                {% endif %}
                <span><i class="bi bi-people" aria-hidden="true"></i> {{ demanda.dem_total_interesses }} interessado(s)</span>
            </div>
            <div class="mt-1">
                Publicada por <strong>{{ demanda.autor_nome }}</strong>
                {% if demanda.dem_dt_publicacao %} · {{ demanda.dem_dt_publicacao|desde }}{% endif %}
            </div>
        </div>
    </div>
</article>
