<svg class="mapa-brasil mapa-amazonas" viewBox="0 0 1200 818" role="group"
     aria-label="Mapa do Amazonas com a quantidade de demandas abertas por município">
    {% for chave, contorno in contornos %}
        {% set dados = municipios[chave]|default({ abertas: 0, total: 0, nivel: 0 }) %}
        <a href="{{ url('/demandas?uf=AM&cidade=' ~ contorno.nome|url_encode) }}" class="mapa-estado mapa-nivel-{{ dados.nivel }}"
           aria-label="{{ contorno.nome }}: {{ dados.abertas }} demanda(s) aberta(s)">
            <title>{{ contorno.nome }}: {{ dados.abertas }} aberta(s){% if detalhado|default(false) %}, {{ dados.total }} no total{% endif %}</title>
            <path d="{{ contorno.caminho }}"/>
        </a>
    {% endfor %}
</svg>
