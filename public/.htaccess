# =============================================================================
# CREA Pro-Link | Apache
#
# Encaminha ao front controller tudo o que não for arquivo existente.
# =============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Não reescreve arquivos e diretórios que existem de fato (assets, uploads)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Impede listagem de diretórios
Options -Indexes

# Nada além de imagens é executável no diretório de uploads
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|py|pl|sh|cgi)$">
        <If "%{REQUEST_URI} =~ m#^/uploads/#">
            Require all denied
        </If>
    </FilesMatch>
</IfModule>

# Cache longo para assets versionados por querystring
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType font/woff2 "access plus 180 days"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
