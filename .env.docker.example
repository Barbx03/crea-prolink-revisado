# =============================================================================
# CREA Pro-Link | Variáveis do ambiente Docker
#
# Copie para .env.docker e preencha. Este arquivo é apenas um modelo e não
# contém credencial real, conforme o item 8.8 do Termo de Referência.
#
#     cp .env.docker.example .env.docker
#     docker compose --env-file .env.docker up -d
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_AMBIENTE=homologacao
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORTA=8080

# --- Banco de dados ----------------------------------------------------------
DB_NOME=crea_prolink
DB_USUARIO=prolink
DB_SENHA=troque-esta-senha
DB_SENHA_ROOT=troque-esta-senha-root
# Porta em que o MariaDB fica acessível no host, para inspeção
DB_PORTA_HOST=3307

# --- API oficial do desafio CREA-AM -----------------------------------------
# Token individual da equipe, obtido em https://desafio-prolink.crea-am.org.br
# A URL base e o formato dos endpoints constam da documentação técnica
# entregue às equipes habilitadas.
CREA_API_URL=https://desafio-prolink.crea-am.org.br/api/v1
CREA_API_TOKEN=
# http = consome a API oficial | offline = não consulta (apenas desenvolvimento)
CREA_API_TIMEOUT=15
CREA_API_DRIVER=http

# As rotas da API nao precisam ser configuradas: ja acompanham a imagem,
# no formato do contrato real da v1 (roteamento por querystring, com
# endpoints proprios para validar ART e CAT por numero). Para sobrescrever
# alguma delas, consulte .env.example.

# Caminho de cada recurso, ajustável conforme a documentação recebida.
# O marcador entre chaves é substituído pelo parâmetro da consulta.

# --- Envio de e-mail --------------------------------------------------------
# Por padrão usa o Mailpit deste ambiente, cuja caixa fica em
# http://localhost:8025 — útil para conferir as notificações do RF07.
MAIL_ATIVO=true
MAIL_HOST=mailpit
MAIL_PORTA=1025
MAIL_SEGURANCA=
MAIL_REMETENTE_EMAIL=nao-responda@prolink.local
MAIL_REMETENTE_NOME="CREA Pro-Link"
MAILPIT_PORTA=8025

# --- Sessão ------------------------------------------------------------------
# Ativar apenas quando a aplicação estiver atrás de HTTPS
SESSAO_COOKIE_SEGURO=false
